// PocketPlan data model — PRD v4 §8 (tables carried from v3 §7 unchanged).
// Money is Decimal(12, 2) in ৳ BDT; currency is hardcoded for MVP (Decision 10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  CASH
  BANK
  CARD
  MOBILE_WALLET
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GroupRole {
  OWNER
  MEMBER
}

// How a group expense is divided (PRD v4 §6.12; percentage and exact were
// moved into scope on 2026-11-16).
enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

// Lower-case to match the API and web app ("system" | "light" | "dark").
enum Theme {
  system
  light
  dark
}

// id is the Supabase auth.users.id. The row (plus default categories and a
// Cash wallet) is created by the on_auth_user_created trigger at sign-up,
// see prisma/migrations/*_auth_users_link.
model User {
  id        String   @id @db.Uuid
  name      String
  email     String   @unique
  theme     Theme    @default(system)
  // Profile photo URL. Step 11: a Supabase Storage URL (demo storage keeps a data URL).
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  accounts          Account[]
  categories        Category[]
  budgets           Budget[]
  expenses          Expense[]            @relation("ExpenseRecordedBy")
  paidExpenses      Expense[]            @relation("ExpensePaidBy")
  recurringExpenses RecurringExpense[]
  savingsGoals      SavingsGoal[]
  createdGroups     Group[]
  groupMemberships  GroupMember[]
  expenseShares     ExpenseParticipant[]
  settlementsPaid   Settlement[]         @relation("SettlementFrom")
  settlementsRecvd  Settlement[]         @relation("SettlementTo")
  invitesSent       GroupInvite[]        @relation("InviteSentBy")
  invitesAccepted   GroupInvite[]        @relation("InviteAcceptedBy")

  @@map("users")
}

// balance is user-maintained and informational, not a ledger (v3 decision 6).
model Account {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  icon      String
  // 'savings' marks the category savings goals count (PRD §6.8); it survives
  // renames and can't be deleted. NULL for every other category.
  systemKey String?  @map("system_key")
  createdAt DateTime @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets           Budget[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@unique([userId, systemKey])
  @@map("categories")
}

model Budget {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  month         Int
  year          Int
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

// Personal expense: group_id null, account + category set, paid_by null (= user_id).
// Group expense: group_id, paid_by, group_category and split_type set; no
// personal account or category, so deleting those never touches group history.
// A CHECK constraint enforces both shapes (migration *_groups_and_sharing).
model Expense {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  accountId     String?    @map("account_id") @db.Uuid
  categoryId    String?    @map("category_id") @db.Uuid
  amount        Decimal    @db.Decimal(12, 2)
  description   String
  expenseDate   DateTime   @map("expense_date") @db.Date
  groupId       String?    @map("group_id") @db.Uuid
  paidBy        String?    @map("paid_by") @db.Uuid
  // Category icon key (ledger.types CATEGORY_ICONS), group expenses only.
  groupCategory String?    @map("group_category")
  splitType     SplitType? @map("split_type")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  user         User                 @relation("ExpenseRecordedBy", fields: [userId], references: [id], onDelete: Cascade)
  payer        User?                @relation("ExpensePaidBy", fields: [paidBy], references: [id], onDelete: Restrict)
  account      Account?             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ExpenseParticipant[]

  @@index([userId, expenseDate])
  @@index([groupId, expenseDate])
  @@index([categoryId])
  @@index([accountId])
  @@map("expenses")
}

// Reminder model: confirming creates an Expense and advances next_due_date (Decision 5).
model RecurringExpense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  description String
  frequency   Frequency
  startDate   DateTime  @map("start_date") @db.Date
  nextDueDate DateTime  @map("next_due_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, nextDueDate])
  @@map("recurring_expenses")
}

// saved_amount is computed from expenses in the category whose system_key is
// 'savings', never stored.
model SavingsGoal {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  month        Int
  year         Int
  targetAmount Decimal  @map("target_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("savings_goals")
}

model Group {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  createdBy     String   @map("created_by") @db.Uuid
  monthlyBudget Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  creator     User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invites     GroupInvite[]

  @@map("groups")
}

model GroupMember {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")
  // Set when the person leaves or is removed; the row stays for history.
  leftAt   DateTime? @map("left_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, leftAt])
  @@map("group_members")
}

model ExpenseParticipant {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId   String  @map("expense_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  shareAmount Decimal  @map("share_amount") @db.Decimal(12, 2)
  // What was typed: percent (PERCENTAGE), share count (SHARES) or taka (EXACT).
  shareValue  Decimal? @map("share_value") @db.Decimal(12, 4)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

model Settlement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  settledAt  DateTime @default(now()) @map("settled_at")

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@map("settlements")
}

// Email invite (email set, single use) or shareable link (email null, usable
// until it expires or is revoked). Only a SHA-256 hash of the token is stored.
model GroupInvite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  email      String?
  tokenHash  String    @unique @map("token_hash")
  role       GroupRole @default(MEMBER)
  invitedBy  String    @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  acceptedBy String?   @map("accepted_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter  User  @relation("InviteSentBy", fields: [invitedBy], references: [id], onDelete: Cascade)
  acceptor User? @relation("InviteAcceptedBy", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([email])
  @@map("group_invites")
}

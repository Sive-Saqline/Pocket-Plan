# Copy to .env and fill in. Never commit .env.

# Supabase → Connect (top bar) → ORMs → Prisma. Copy both lines exactly and
# replace [YOUR-PASSWORD] (letters and numbers only avoids URL-escaping issues).
# connect_timeout=30: the first connection can take a few seconds, and Prisma
# gives up after 5 s by default.
# Runtime: the session pooler (port 5432) as well. The transaction pooler (6543,
# pgbouncer=true) needs ~5 network round trips per query with Prisma: much slower.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=30&connection_limit=5"
# Migrations: session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=30"

# Supabase → Project Settings → Data API → Project URL (nothing after .supabase.co)
SUPABASE_URL="https://<project-ref>.supabase.co"
# Supabase → Project Settings → API Keys → service_role (Reveal). Bypasses RLS: server only.
SUPABASE_SERVICE_ROLE_KEY=""
# Only for projects that still use the legacy JWT secret (Project Settings → JWT Keys).
# Projects with signing keys leave this empty; tokens are checked against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=""

# AI suggestions (Step 18). Server-side only; never exposed to the web app.
# Google AI Studio (aistudio.google.com) → Get API key. Leave the key empty to
# switch the AI off: every form still works by hand.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# Optional: the model (default gemini-2.5-flash) and time limit (default 10000 ms)
AI_MODEL="gemini-2.5-flash"
# AI_TIMEOUT_MS=10000

PORT=3001
WEB_ORIGIN="http://localhost:3000"


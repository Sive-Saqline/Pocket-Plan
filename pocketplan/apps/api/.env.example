# Supabase → Project Settings → Database → Connection string
# Pooled connection (port 6543, pgbouncer) used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWT_SECRET=""

# Server-side only; never exposed to the web app
ANTHROPIC_API_KEY=""

PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Signs login tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
# Demo account store until the database work lands
USERS_FILE=".data/users.json"
LEDGER_DIR=".data/ledger"

{
  "name": "pocketplan",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @pocketplan/api",
    "dev:web": "npm run dev -w @pocketplan/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm test -w @pocketplan/api",
    "db:generate": "npm run db:generate -w @pocketplan/api",
    "db:migrate": "npm run db:migrate -w @pocketplan/api",
    "db:studio": "npm run db:studio -w @pocketplan/api",
    "test:e2e": "npm run test:e2e -w @pocketplan/api -- auth ledger recurring"
  }
}
